<div class="mb-20 grid grid-cols-1 gap-16 lg:grid-cols-2">
  <div>
    <h2 class="mb-6 text-4xl font-bold">¿Listo para escalar tu negocio?</h2>
    <p class="mb-8 max-w-md text-lg text-white/70">
      Hablemos sobre tu proyecto. Agenda una llamada gratuita de 30 minutos con nosotros.
    </p>
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10">
          <span class="font-icon">mail</span>
        </div>
        <span>contacto@lavirosolutions.com</span>
      </div>
      <div class="flex items-center gap-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10">
          <span class="font-icon">phone</span>
        </div>
        <span>+34 600 123 456</span>
      </div>
      <div class="flex items-center gap-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10">
          <span class="font-icon">location_on</span>
        </div>
        <span>Madrid, España</span>
      </div>
    </div>
  </div>
  <!-- Contact Form -->
  <div class="bg-background text-background-foreground rounded-2xl p-8 shadow-2xl">
    <h3 class="mb-6 text-2xl font-bold">Envíanos un mensaje</h3>
    <form class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div class="space-y-1">
          <label class="text-xs font-bold text-slate-500 uppercase">Nombre</label>
          <input
            class="focus:border-primary focus:ring-primary bg-surface border-border w-full rounded-lg border px-4 py-3 transition-all focus:ring-1 focus:outline-none"
            placeholder="Tu nombre"
            type="text"
          />
        </div>
        <div class="space-y-1">
          <label class="text-xs font-bold text-slate-500 uppercase">Email</label>
          <input
            class="focus:border-primary focus:ring-primary bg-surface border-border w-full rounded-lg border px-4 py-3 transition-all focus:ring-1 focus:outline-none"
            placeholder="tucorreo@ejemplo.com"
            type="email"
          />
        </div>
      </div>
      <div class="space-y-1">
        <label class="text-xs font-bold text-slate-500 uppercase">Mensaje</label>
        <textarea
          class="focus:border-primary focus:ring-primary bg-surface border-border w-full rounded-lg border px-4 py-3 transition-all focus:ring-1 focus:outline-none"
          placeholder="Cuéntanos sobre tu proyecto..."
          rows="4"></textarea>
      </div>
      <button
        class="bg-primary hover:bg-primary-dark shadow-primary/30 mt-4 w-full rounded-lg py-4 font-bold text-white shadow-lg transition-colors"
      >
        Enviar Mensaje
      </button>
    </form>
  </div>
</div>
